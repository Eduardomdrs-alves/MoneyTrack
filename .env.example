# Conexão com o MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://usuario:senha@cluster.mongodb.net/moneytrack?retryWrites=true&w=majority"

# URL da aplicação (na Vercel, use o domínio do projeto)
NEXTAUTH_URL="http://localhost:3000"

# Chave secreta usada para assinar o JWT da sessão
# Gere uma com: npx auth secret   ou   openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-uma-chave-secreta"
